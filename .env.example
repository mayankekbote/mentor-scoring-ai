# AI Interview Submission Platform — Environment Variables Example
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_db

# ── JWT / Auth ────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Engine ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# ── File Storage ──────────────────────────────────────────────────────────
UPLOAD_DIR=storage/uploads

# ── App ───────────────────────────────────────────────────────────────────
AI_ENGINE_ENABLED=true
FRONTEND_HOST=http://localhost:5173/forgot-password

# ── Email / SMTP ──────────────────────────────────────────────────────────
EMAILS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mayankekbote12@gmail.com
SMTP_PASSWORD=wwfa qebb xkxy atxy
EMAILS_FROM_EMAIL=no-reply@mentorai.com
EMAILS_FROM_NAME=MentorAI
